{
    "name": "@10k24/p5b",
    "version": "1.2.2",
    "description": "Run p5.js sketches in Node.js and stream RGBA pixel buffers",
    "author": "10k24",
    "main": "p5b.js",
    "exports": {
        ".": {
            "require": "./p5b.js",
            "import": "./p5b.mjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/10k24/p5b.js.git"
    },
    "homepage": "https://github.com/10k24/p5b.js#readme",
    "keywords": [
        "p5",
        "p5-js",
        "p5.js",
        "canvas",
        "graphics",
        "pixel-buffer",
        "rgba",
        "nodejs",
        "processing",
        "generative-art",
        "headless"
    ],
    "scripts": {
        "test": "bun run validate:docs && bun test",
        "test:v1": "P5B_P5_PATH=p5 bun test",
        "test:v2": "P5B_P5_PATH=p5-v2 bun test",
        "test:all": "bun run test:v1 && bun run test:v2 && bun run validate:docs",
        "test:coverage": "P5B_P5_PATH=p5 bun test --coverage && P5B_P5_PATH=p5-v2 bun test --coverage",
        "test:webgl": "P5B_P5_PATH=p5-v2 node --test --test-force-exit test/webgl.node.js test/webgl-shaders.node.js",
        "coverage:html": "node scripts/coverage-report.js",
        "postinstall": "node scripts/patch-gifenc.js",
        "test:watch": "bun test --watch",
        "lint": "bunx eslint",
        "drift": "node scripts/compare-adapters.js",
        "fix": "bunx eslint --fix",
        "docs": "node scripts/build-docs.js",
        "validate:docs": "node scripts/validate-docs.js"
    },
    "license": "LGPL-2.1-only",
    "engines": {
        "node": ">=20.0.0"
    },
    "type": "commonjs",
    "files": [
        "p5b.js",
        "p5b.mjs",
        "lib/globals.js",
        "lib/p5b-base.js",
        "lib/p5b_v1.js",
        "lib/p5b_v2.js",
        "lib/p5b-dom.js",
        "README.md",
        "LICENSE"
    ],
    "peerDependencies": {
        "p5": "^1.6.0 || ^2.0.0"
    },
    "peerDependenciesMeta": {
        "p5": {
            "optional": false
        }
    },
    "dependencies": {
        "canvas": "^3.2.3",
        "opentype.js": "^1.3.4"
    },
    "optionalDependencies": {
        "gl": "^8.1.6"
    },
    "devDependencies": {
        "dot": "^1.1.3",
        "eslint": "^9.39.0",
        "p5": "^1.11.12",
        "p5-v2": "npm:p5@^2.0.0"
    }
}
